#!/bin/bash
# CKA between monkeys N and F (same area), val split, batches of 64; neural data only (CPU).
# A few minutes (estimate).
#   cd CordsNet/Round3/slurm && sbatch monkey_cka.sbatch [extra monkey_cka.py arguments]

#SBATCH --job-name=r3_monkey_cka
#SBATCH --account=torch_pr_628_cds
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G
#SBATCH --time=01:00:00
#SBATCH --output=/scratch/wz2723/cordsnet_runs/slurm_logs/%x_%j.out
#SBATCH --mail-type=BEGIN,END,FAIL
#SBATCH --mail-user=wz2723@nyu.edu

set -euo pipefail
REPO=/scratch/wz2723/dynvision/DynVision
OVERLAY=/scratch/wz2723/dynvision/overlay-15GB-500K.ext3
SIF=/share/apps/images/cuda12.1.1-cudnn8.9.0-devel-ubuntu22.04.2.sif
EXTRA="$*"

echo "==== START $(date)  job ${SLURM_JOB_ID} on $(hostname)"
echo "extra: ${EXTRA}  code: $(git -C "$REPO" rev-parse --short HEAD)"
singularity exec --overlay "$OVERLAY:ro" "$SIF" /bin/bash -c "
set -euo pipefail
source /ext3/miniforge3/etc/profile.d/conda.sh
conda activate dynvision
cd '$REPO/CordsNet/Round3/monkey_cka'
python -u monkey_cka.py $EXTRA
"
echo "==== DONE $(date)"
